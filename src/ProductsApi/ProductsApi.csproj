<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Target .NET 8 LTS -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProductsApi</RootNamespace>
    <AssemblyName>ProductsApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core with SQL Server provider -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <!-- EF Core design-time tooling (for migrations via CLI) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Swagger / OpenAPI UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!-- Serilog structured logging with ASP.NET Core integration -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <!-- Seq sink — sends structured logs over HTTP to the Seq server -->
    <PackageReference Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <!-- Enriches every log event with the machine/container hostname -->
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.0" />
    <!-- Enriches every log event with the managed thread id -->
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
  </ItemGroup>

</Project>
